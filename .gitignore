# Dependencies (recreated with `npm install`)
node_modules/

# Environment variables: SECRETS, never commit!
.env
.env.*
!.env.example

# Build output
dist/
build/

# Code generated by tools (recreated with `npm install` / `prisma generate`)
generated/

# Logs
*.log

# Test coverage reports
coverage/

# OS junk files
.DS_Store
Thumbs.db

# Claude Code personal settings (per-person, not shared)
.claude/settings.local.json

# Python (API in apps/api-py, evals later)
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
