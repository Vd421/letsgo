{
  "name": "replay",
  "version": "0.0.0",
  "private": true,
  "description": "Session replay tool with AI bug detection",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e": "playwright test",
    "test": "npm run test --workspaces --if-present",
    "shop": "npm run dev -w @replay/demo-site",
    "dashboard": "npm run dev -w @replay/dashboard",
    "worker": "cd apps/api-py && .venv\\Scripts\\python -m celery -A app.celery_app worker --pool=solo --loglevel=info",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down"
  }
}
