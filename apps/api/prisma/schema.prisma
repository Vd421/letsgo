// Prisma schema: the "blueprint" of our database tables.
// After changing it, run `npm run db:migrate -w @replay/api` to update the real database.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One recorded visit to a website.
model Session {
  id         String    @id @default(uuid()) // unique ID, generated automatically
  url        String // page where the recording started
  userAgent  String? // visitor's browser info (optional)
  startedAt  DateTime  @default(now()) // filled in automatically
  endedAt    DateTime? // empty while the session is still going
  eventCount Int       @default(0) // number of recorded clicks/scrolls/typing events
}
