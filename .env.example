# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. NEVER put real secrets in this example file.

# --- App ---
PORT=4000

# --- Postgres ---
# Local default matches the Docker Compose database (Phase 0, Step 9).
# For Neon, paste the connection string from the Neon dashboard instead.
DATABASE_URL=postgresql://replay:replay@localhost:5432/replay

# --- Redis (used by the Celery job queue) ---
REDIS_URL=redis://localhost:6379

# --- AWS S3 (stores recorded session events) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=replay-sessions

# --- Claude API (AI summaries and bug detection) ---
ANTHROPIC_API_KEY=
