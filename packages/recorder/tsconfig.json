{
  // Shared rules live in the base file; these are the recorder-specific extras.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Browser code, bundled by Vite: modern modules, and the browser's built-in types (DOM).
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["src"]
}
